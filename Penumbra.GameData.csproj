<Project Sdk="Dalamud.NET.Sdk/14.0.1">
    <PropertyGroup>
        <AssemblyTitle>Penumbra.GameData</AssemblyTitle>
        <Product>Penumbra</Product>
        <Copyright>Copyright © 2025</Copyright>
        <OutputPath>bin\$(Configuration)\</OutputPath>
    </PropertyGroup>

    <PropertyGroup>
        <Use_DalamudPackager>false</Use_DalamudPackager>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FlatSharp.Runtime" Version="7.9" />
        <PackageReference Include="FlatSharp.Compiler" Version="7.9" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="api14-deps\Penumbra.Api\Penumbra.Api.csproj" />
        <ProjectReference Include="api14-deps\Penumbra.String\Penumbra.String.csproj" />
        <ProjectReference Include="api14-deps\OtterGui\OtterGui.csproj" />
    </ItemGroup>

    <ItemGroup>
        <FlatSharpSchema Include="Schema/epbd_schema.fbs" />
    </ItemGroup>

    <ItemGroup>
      <None Include="epbd_schema.fbs" />
    </ItemGroup>
    <ItemGroup><Compile Remove="api14-deps/**/*.cs" /><EmbeddedResource Remove="api14-deps/**" /><None Remove="api14-deps/**" /></ItemGroup>
</Project>
